# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_profiles
DB_USER=root
DB_PASS=

# Application Configuration
APP_NAME="Student Profile Management"
APP_URL=http://host
APP_ENV=development
APP_DEBUG=true
APP_KEY=your-secret-key-here

# Security Configuration
SESSION_LIFETIME=7200
REMEMBER_ME_LIFETIME=2592000
CSRF_TOKEN_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# Email Configuration (for 2FA and notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Student Profile System"

# SMS Configuration (Twilio for 2FA)
TWILIO_SID=your-twilio-sid
TWILIO_TOKEN=your-twilio-token
TWILIO_PHONE=+1234567890

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif
UPLOAD_PATH=uploads/

# API Keys
HAVEIBEENPWNED_API_KEY=your-api-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# WebSocket Configuration
WS_HOST=localhost
WS_PORT=8080

# Backup Configuration
BACKUP_PATH=backups/
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_SCHEDULE=0 2 * * *

# Analytics Configuration
ANALYTICS_ENABLED=true
HEATMAP_ENABLED=true

# PWA Configuration
PWA_NAME="Student Profiles"
PWA_SHORT_NAME="StudentProfiles"
PWA_DESCRIPTION="Student Profile Management System"
PWA_THEME_COLOR="#1a1a1a"
PWA_BACKGROUND_COLOR="#000000"
